# Адрес бэкенда. На телефоне localhost — это сам телефон: укажите IP компьютера в той же Wi-Fi сети.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# osm — рисовать подложку OpenStreetMap (на Android не нужен ключ Google). Пусто — системная карта.
EXPO_PUBLIC_MAP_TILES=

# Нужны только для собственной сборки (EAS / prebuild). В Expo Go не нужны.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
