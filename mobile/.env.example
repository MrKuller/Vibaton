# Адрес бэкенда. На телефоне localhost — это сам телефон: укажите IP компьютера в той же Wi-Fi сети
# (ipconfig -> IPv4-адрес), IP вашего сервера или адрес туннеля cloudflared (см. README).
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Карта: OpenStreetMap, ключ не нужен. Свой тайловый сервер можно указать здесь (необязательно):
# EXPO_PUBLIC_MAP_TILE_URL=https://ваш-сервер/tiles/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_ATTRIBUTION=© участники OpenStreetMap
