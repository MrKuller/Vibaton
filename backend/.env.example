# Скопируйте этот файл в .env и поправьте значения.

# База MySQL. Создайте базу и пользователя скриптом sql/mysql_setup.sql (см. README).
# Laragon / OSPanel без пароля root: mysql+pymysql://root:@localhost:3306/krepkiy_led?charset=utf8mb4
DATABASE_URL=mysql+pymysql://krepkiy:ПАРОЛЬ@localhost:3306/krepkiy_led?charset=utf8mb4

# Секрет для подписи проверочных примеров при регистрации. Пусто — сгенерируется в data/secret.key.
SECRET_KEY=

# Модели (файлы кладите в backend/models/). Нет файла — работают запасные алгоритмы.
FACE_LP_MODEL_PATH=models/yolo26m_face_lp.pt
ICE_MODEL_PATH=models/ice.pt
# Сколько фото обрабатывать одновременно (модели тяжёлые)
PHOTO_WORKERS=2

# Защита от перегрузки
RATE_LIMIT_ENABLED=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=3000
# 1 — только если сервер стоит за вашим nginx или cloudflared: тогда IP клиента берётся из X-Forwarded-For
TRUSTED_PROXY=0

# Локальные языковые модели через Ollama. Без них работают правила.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
KL_OFFLINE=0
KL_DISABLE_LLM=0
